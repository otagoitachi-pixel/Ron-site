{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ron-site",
  "main": "_worker.js",
  "compatibility_date": "2026-10-11",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": { "directory": ".", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ron-collection-db",
      "database_id": "ff1b0fe5-a4bc-40ec-b411-85518b407060"
    }
  ]
}
